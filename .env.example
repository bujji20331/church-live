# =============================================================================
# CHURCH LIVE — ENVIRONMENT CONFIGURATION EXAMPLE (Phase 2)
# =============================================================================
# Copy this file to '.env' and fill in the values.
# 
# IMPORTANT SECURITY WARNINGS:
# - NEVER commit your actual '.env' file containing secrets to Git or GitHub.
# - .env is listed in .gitignore and MUST NOT be committed.
# - ONLY public/non-sensitive config should be loaded on the static frontend.
# - Private secrets here are intended for the local Python helper/backend services.
# - Supabase service-role keys MUST NEVER be placed in the frontend.
# - GitHub Pages is a static frontend; the final secure architecture will use
#   appropriate Supabase configuration and server-side/Edge Function handling
#   where secrets are required.
# - Do NOT put real API keys or credentials into this file.
# =============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Public credentials used by Frontend App (safe for static frontend in Phase 3+).
# These are the anon/public key only — NOT the service-role key.
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ------------------------------------------------------------------------------
# YOUTUBE API & OAUTH CONFIGURATION (For local helper / backend sync)
# ------------------------------------------------------------------------------
# YouTube OAuth 2.0 credentials. These must NOT be in frontend code.
YOUTUBE_CLIENT_ID=your-youtube-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:8080/oauth2callback
YOUTUBE_REFRESH_TOKEN=your-youtube-oauth-refresh-token
YOUTUBE_CHANNEL_ID=your-church-youtube-channel-id

# ------------------------------------------------------------------------------
# OBS STUDIO CONFIGURATION (For OBS WebSockets control via local helper)
# ------------------------------------------------------------------------------
OBS_WEBSOCKET_HOST=localhost
OBS_WEBSOCKET_PORT=4455
OBS_WEBSOCKET_PASSWORD=your-obs-websocket-password

# ------------------------------------------------------------------------------
# LOCAL HELPER SERVICE CONFIGURATION
# ------------------------------------------------------------------------------
LOCAL_HELPER_PORT=8000
LOCAL_HELPER_SECRET_KEY=your-helper-api-secret-key
CHURCH_LAPTOP_ID=church-laptop-01
